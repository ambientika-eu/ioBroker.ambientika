{
    "i18n": true,
    "type": "panel",
    "items": {
        "connection": {
            "type": "select",
            "label": "Connection type",
            "options": [
                {
                    "label": "Ambientika cloud (recommended)",
                    "value": "cloud"
                },
                {
                    "label": "Ambientika MQTT Bridge",
                    "value": "mqtt"
                }
            ],
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_cloudInfo": {
            "type": "staticText",
            "text": "Sign in with the e-mail address and the password of your Ambientika app. The adapter finds all units of the account on its own.",
            "hidden": "data.connection === 'mqtt'",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "username": {
            "type": "text",
            "label": "E-mail address",
            "trim": true,
            "hidden": "data.connection === 'mqtt'",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "password": {
            "type": "password",
            "label": "Password",
            "repeat": false,
            "visible": true,
            "hidden": "data.connection === 'mqtt'",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "pollInterval": {
            "type": "number",
            "label": "Reading interval",
            "help": "Seconds between two readings of all units (10 to 3600)",
            "min": 10,
            "max": 3600,
            "step": 1,
            "hidden": "data.connection === 'mqtt'",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_mqttInfo": {
            "type": "staticText",
            "text": "The adapter reads the topics of the Ambientika MQTT Bridge. Use the same MQTT broker and topic prefix as the bridge.",
            "hidden": "data.connection !== 'mqtt'",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "mqttHost": {
            "type": "text",
            "label": "MQTT broker host",
            "hidden": "data.connection !== 'mqtt'",
            "newLine": true,
            "xs": 12,
            "sm": 8,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "mqttPort": {
            "type": "number",
            "label": "Port",
            "min": 1,
            "max": 65535,
            "hidden": "data.connection !== 'mqtt'",
            "xs": 12,
            "sm": 4,
            "md": 2,
            "lg": 2,
            "xl": 2
        },
        "mqttUser": {
            "type": "text",
            "label": "User",
            "hidden": "data.connection !== 'mqtt'",
            "newLine": true,
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 3,
            "xl": 3
        },
        "mqttPassword": {
            "type": "password",
            "label": "Password",
            "repeat": false,
            "hidden": "data.connection !== 'mqtt'",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 3,
            "xl": 3
        },
        "mqttTls": {
            "type": "checkbox",
            "label": "Use TLS (mqtts)",
            "hidden": "data.connection !== 'mqtt'",
            "newLine": true,
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 3,
            "xl": 3
        },
        "mqttTlsInsecure": {
            "type": "checkbox",
            "label": "Accept self-signed certificates",
            "hidden": "data.connection !== 'mqtt' || !data.mqttTls",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 3,
            "xl": 3
        },
        "mqttPrefix": {
            "type": "text",
            "label": "Topic prefix of the bridge",
            "hidden": "data.connection !== 'mqtt'",
            "newLine": true,
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 3,
            "xl": 3
        },
        "discoveryPrefix": {
            "type": "text",
            "label": "Discovery prefix (unit names)",
            "help": "Leave empty if the bridge does not publish Home Assistant discovery",
            "hidden": "data.connection !== 'mqtt'",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 3,
            "xl": 3
        }
    }
}
